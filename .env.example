# Supabase — Project Settings → API
# El anon key es público (va al cliente); su seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Bot SIGSA (Playwright) — NO corre en Vercel serverless. Se despliega aparte
# (Cloud Run / Docker con el Dockerfile incluido) y se apunta acá su URL pública.
# Si se deja vacío, la app usa la ruta interna /api/sigsa/declarar (sólo sirve fuera de Vercel).
NEXT_PUBLIC_BOT_URL=

# --- Sólo para tareas administrativas locales (NO se sube a git ni al cliente) ---
# Service role key: úsalo sólo en scripts server-side/CLI; nunca lo expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=
